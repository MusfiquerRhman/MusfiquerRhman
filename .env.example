# Local PostgreSQL: npm run setup:local then npm run db:start
DATABASE_URL=postgresql://portfolio:YOUR_PASSWORD@127.0.0.1:15432/portfolio
SITE_URL=http://localhost:3000
# Optional exact HTTPS aliases, separated by commas, for form origin checks.
SITE_ALLOWED_ORIGINS=
ADMIN_EMAIL=musfiquerrhman@gmail.com
# Generate with npm run admin:password; never use a plaintext password here.
ADMIN_PASSWORD_HASH=
# SMTP credentials belong only in .env.local, which is ignored by Git.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=musfiquerrhman@gmail.com
SMTP_PASSWORD=
SMTP_FROM=Musfiquer Rhman <musfiquerrhman@gmail.com>
CONTACT_TO=musfiquerrhman@gmail.com
# Enable only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
